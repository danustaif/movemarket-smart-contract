# Dibaca otomatis oleh `forge script` (Foundry memuat .env di root proyek). Isi hanya ALAMAT publik.
# Private key TIDAK disimpan di sini: pakai keystore cast (`cast wallet import <nama> --interactive`),
# lalu `forge script ... --account <nama>`. Lihat DEPLOY.md.

# Wajib: wallet resolver (role resolver LiveMarket + minter tUSDC).
RESOLVER_ADDRESS=

# Opsional: default addresses.creMockKeystoneForwarder di ../source/sot/constants.json.
# Ganti ke KeystoneForwarder produksi hanya setelah workflow CRE di-deploy ke DON.
FORWARDER_ADDRESS=

# RPC Monad Testnet (publik).
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
